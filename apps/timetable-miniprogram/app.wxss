@import "styles/vars.wxss";

page {
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
  font-size: 16px;
  line-height: 1.6;
}

view, text, button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: inherit;
}

/* 收敛三档：透明度 / 浅底 / 变色 */
.tap-press {
  opacity: 0.6;
}

.tap-row {
  background: #F7F5EF;
}

.tap-accent {
  color: var(--accent);
  opacity: 0.75;
}

/* 主按钮按压：实底加深，文字不压透明度 */
.press-brand {
  background: #285E4D;
}

.press-red {
  background: linear-gradient(180deg, #E85F50 0%, #D63523 100%);
}

/* 线性箭头基元：统一 3rpx 线宽，颜色继承容器 */
.arrow {
  flex: none;
  width: 14rpx;
  height: 14rpx;
}

.arrow-r {
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.arrow-l {
  border-top: 3rpx solid currentColor;
  border-left: 3rpx solid currentColor;
  transform: rotate(-45deg);
}

.arrow-d {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
}

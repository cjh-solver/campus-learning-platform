.page {
  padding: 8rpx 12rpx 132rpx;
}

/* 空态没有底栏，底部不必再给固定栏让位 */
.page-empty {
  padding-bottom: 40rpx;
}

/* 整块课表：表头与网格同宽，列线才对得齐 */
.board {
  background: var(--card);
  border-radius: 16rpx;
  overflow: hidden;
}

/* 顶栏白底：周次和日期区间居中，右侧只留一个切换周末的文字键 */
.hero {
  background: var(--card);
  border-bottom: 1rpx solid var(--line);
}

.hero-top {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx 10rpx;
}

.h-btn {
  width: 88rpx;
  height: 88rpx;
  margin: -16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  border-radius: 12rpx;
  flex: none;
}

.h-title {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.h-main {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0.02em;
  line-height: 1.3;
}

.h-sub {
  font-size: 15rpx;
  color: var(--muted);
  letter-spacing: 0.06em;
  margin-top: 2rpx;
}

.h-pill {
  flex: none;
  font-size: 20rpx;
  color: var(--accent);
  background: var(--brand-soft);
  border-radius: 999rpx;
  padding: 12rpx 22rpx;
  letter-spacing: 0.04em;
}

/* 翻到本周三周以外才出现：周次条下面一条窄键，点一下回本周 */
.week-back {
  flex: none;
}

.wb-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 28rpx;
  background: var(--brand-soft);
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
}

/* 表头：上面星期，下面日期号；左侧「节次」与网格等宽 */
.head-row {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0 4rpx;
}

.head-time {
  width: 68rpx;
  flex: none;
  text-align: center;
  padding-top: 14rpx;
}

.ht-label {
  font-size: 13rpx;
  letter-spacing: 0.14em;
  color: var(--muted);
}

.head-day {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.hd-label {
  font-size: 19rpx;
  line-height: 1.4;
  color: var(--ink);
  font-weight: 700;
  letter-spacing: 0.02em;
}

.hd-date {
  font-size: 16rpx;
  line-height: 1.4;
  color: var(--muted);
  letter-spacing: 0.04em;
}

/* 今天那一列：表头到网格铺品牌浅底，扫一眼就落在今天 */
.head-day.today {
  background: var(--brand-soft);
  border-bottom: 3rpx solid rgba(46, 107, 87, 0.26);
}

.head-day.today .hd-label,
.head-day.today .hd-date {
  color: var(--accent);
}

.day-col.today {
  background: #F2F7F4;
  box-shadow: inset 1rpx 0 0 rgba(46, 107, 87, 0.18), inset -1rpx 0 0 rgba(46, 107, 87, 0.18);
}

.swipe {
  display: flex;
  padding: 0 0 2rpx;
  overflow: hidden;
}

/* 固定列必须压住轨道：上周屏停在轨道左缘外侧，首列会落进这 68rpx，
   不抬高就是两层文字叠在一起。白底负责遮挡，z-index 保证顺序。 */
.fixed-col {
  width: 68rpx;
  flex: none;
  position: relative;
  z-index: 3;
  background: var(--card);
}

.track {
  flex: 1;
  min-width: 0;
  position: relative;
}

.pane {
  width: 100%;
  min-width: 0;
}

.pane-prev,
.pane-next {
  position: absolute;
  top: 0;
  left: 0;
}

.pane-prev {
  left: -100%;
}

.pane-next {
  left: 100%;
}

/* 静止态收起两侧屏：不占位、不重建节点，只掐可见性 */
.pane-off {
  visibility: hidden;
}

.period-col {
  width: 68rpx;
  flex: none;
}

.period {
  height: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid var(--line);
}

.p-n {
  font-size: 18rpx;
  color: #5E655F;
  font-weight: 600;
  line-height: 1.3;
}

.p-t {
  font-size: 14rpx;
  color: var(--muted);
  line-height: 1.4;
  letter-spacing: 0.01em;
}

/* 上午 1-4、下午 5-8、晚上 9-10：分组处压一条稍深的分隔线 */
.period.break {
  border-top: 1rpx solid #DCD9CF;
}

.period.current .p-n {
  color: var(--accent);
  font-weight: 700;
}

/* 今天当前所在格：品牌浅底提示 */
.cell.current {
  background: rgba(46, 107, 87, 0.08);
}

.day-cols {
  min-width: 0;
  position: relative;
  display: flex;
}

.day-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.cell {
  height: 84rpx;
  border-right: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 空格里的浅灰加号，说明这格能点开加课；有课的位置被课程块压住，看不见 */
.cell-plus {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  pointer-events: none;
}

.cell-plus::before,
.cell-plus::after {
  content: "";
  position: absolute;
  background: #E3DFD4;
  border-radius: 1rpx;
}

.cell-plus::before {
  left: 0;
  top: 50%;
  width: 100%;
  height: 2rpx;
  transform: translateY(-50%);
}

.cell-plus::after {
  top: 0;
  left: 50%;
  height: 100%;
  width: 2rpx;
  transform: translateX(-50%);
}

/* 一门课占一对节次，每两节一条稍深的横线，一眼看出分组 */
.cell.pair-end {
  border-bottom-color: #DCD9CF;
}

/* 课程块按列宽百分比定位；透明边留给块间缝隙，不撑出列外 */
.block {
  position: absolute;
  box-sizing: border-box;
  border: 4rpx solid transparent;
  background-clip: padding-box;
  border-radius: 10rpx;
  padding: 14rpx 4rpx 10rpx 8rpx;
  color: #fff;
  overflow: hidden;
  transition: transform 0.15s ease;
}

/* 按压不压透明度：实色块变透会透出底色发灰，改成轻微收拢 */
.block.tap-press {
  opacity: 1;
  transform: scale(0.98);
}

/* 课程名最多两行，超长截断；js 里已在语义处插了换行 */
.b-name {
  font-size: 20rpx;
  line-height: 1.26;
  font-weight: 600;
  color: #fff;
  letter-spacing: 0.01em;
  white-space: pre-line;
  word-break: break-all;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.b-meta {
  margin-top: 6rpx;
}

.b-sub {
  font-size: 14rpx;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: 0.02em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 开周末时七列变窄，块内字号跟着收一档，不然中文只能放三个字 */
/* 同格劈成两半、或文字特别长时，字号退一档，别把课名断成四行 */
.block.dense .b-name {
  font-size: 17rpx;
}

.block.dense .b-sub {
  font-size: 12rpx;
}

.week7 .b-name {
  font-size: 17rpx;
}

.week7 .p-n {
  font-size: 16rpx;
}

.week7 .p-t {
  font-size: 13rpx;
}

.empty {
  padding: 90rpx 32rpx 100rpx;
  text-align: center;
  color: var(--muted);
}

/* 空态引导图标：品牌浅底圆角方，内部线性日历轮廓 */
.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 28rpx;
  border-radius: 28rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ei-cal {
  width: 42rpx;
  height: 38rpx;
  border: 3rpx solid var(--accent);
  border-radius: 8rpx;
  position: relative;
}

.ei-cal::before {
  content: "";
  position: absolute;
  top: -3rpx;
  left: 9rpx;
  width: 3rpx;
  height: 10rpx;
  background: var(--accent);
  box-shadow: 21rpx 0 0 var(--accent);
}

.ei-cal::after {
  content: "";
  position: absolute;
  top: 13rpx;
  left: 7rpx;
  right: 7rpx;
  height: 3rpx;
  background: rgba(46, 107, 87, 0.3);
}

.et {
  font-size: 32rpx;
  color: var(--ink);
  font-weight: 600;
}

.es {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

/* 空表引导：一句话说清要导入什么，分段与主按钮在卡片内同组居中 */
.role-switch.in-empty {
  margin: 36rpx auto 0;
}

.empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 36rpx;
  padding: 0 56rpx;
  border-radius: 44rpx;
  background: var(--accent);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

/* 次入口：两个浅底按钮并排 */
.empty-links {
  margin-top: 28rpx;
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.el-btn {
  height: 72rpx;
  padding: 0 30rpx;
  border-radius: 36rpx;
  background: #F7F5EF;
  color: var(--accent);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 底栏：导入是主操作，选班级挨在它右边，粘贴在右侧次位 */
.foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: var(--card);
  border-top: 1rpx solid var(--line);
}

.f-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.f-import {
  position: relative;
  min-width: 196rpx;
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: 30rpx;
  background: var(--accent);
  color: #fff;
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

/* 选班级跟导入是一组，间距按 18rpx 卡住，既不粘一起也不散开 */
.f-kb {
  position: relative;
  min-width: 200rpx;
  height: 64rpx;
  padding: 0 28rpx;
  margin-left: 18rpx;
  border-radius: 30rpx;
  border: 2rpx solid rgba(46, 107, 87, 0.34);
  color: var(--accent);
  font-size: 19rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

/* 换身份时两层文字叠在同一个位置，靠透明度交替换，按钮外形一点不动 */
.fi-word {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.22s ease;
}

.fi-word.on {
  opacity: 1;
}

.f-link.dim {
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s ease;
}

.f-link {
  font-size: 19rpx;
  color: var(--accent);
  letter-spacing: 0.04em;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: #F7F5EF;
  display: flex;
  align-items: center;
  margin-left: 18rpx;
}

/* 粘贴导入：输入框 + 三个工具键 + 预览 */
.paste-area {
  width: 100%;
  min-height: 260rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #F6F4EE;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink);
}

.paste-tools {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.paste-tool {
  flex: 1;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #F6F4EE;
  font-size: 25rpx;
  color: var(--accent);
}

.pv-list {
  margin-top: 16rpx;
  max-height: 320rpx;
  overflow-y: auto;
}

.pv-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.pv-name {
  font-size: 27rpx;
  color: var(--ink);
}

.pv-meta {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(26, 30, 28, 0.42);
  z-index: 20;
  animation: mask-in 0.2s ease-out;
}

.mask.leaving {
  animation: mask-out 0.18s ease-in forwards;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 30;
  animation: sheet-in 0.24s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.sheet.leaving {
  animation: sheet-out 0.18s ease-in forwards;
}

@keyframes mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes mask-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes sheet-in {
  from { transform: translateY(140rpx); }
  to { transform: translateY(0); }
}

@keyframes sheet-out {
  from { transform: translateY(0); }
  to { transform: translateY(140rpx); }
}

/* 表单弹层内容多，限高可滚，避免小屏把保存按钮顶出屏幕 */
.sheet.form {
  max-height: 80vh;
  overflow-y: auto;
}

.sheet-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  padding: 12rpx 0 12rpx;
}

.sheet-meta {
  text-align: center;
  font-size: 23rpx;
  color: var(--muted);
  margin-bottom: 18rpx;
}

.sheet-sub {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  margin: -4rpx 0 18rpx;
}

.sheet-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-top: 1rpx solid var(--line);
  color: var(--ink);
}

.sheet-btn.danger {
  color: #C0504B;
}

.sheet-btn.ghost {
  color: var(--muted);
}

.sheet-btn.primary {
  background: var(--accent);
  color: #fff;
  border-radius: 18rpx;
  border-top: none;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.sheet-actions .sheet-btn {
  flex: 1;
  border-top: none;
  border-radius: 18rpx;
  background: #F6F4EE;
}

.sheet-actions .sheet-btn.primary {
  background: var(--accent);
  color: #fff;
}

.field {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.field-row {
  display: flex;
  gap: 24rpx;
}

.field.half {
  flex: 1;
}

.field-label {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.field-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.field-picker {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

/* 班级课表：顶部那行来源提示 */
.kb-note {
  padding: 0 16rpx 8rpx;
  font-size: 17rpx;
  color: var(--muted);
  letter-spacing: 0.02em;
}

/* 身份切换：学生 / 老师，胶囊两段，跟在课表下面 */
.role-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 22rpx 4rpx 0;
}

.role-switch {
  display: flex;
  align-items: center;
  width: 296rpx;
  height: 64rpx;
  padding: 7rpx;
  box-sizing: border-box;
  background: #EDEAE1;
  border-radius: 999rpx;
}

.rs-item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 21rpx;
  color: #7C847D;
  border-radius: 999rpx;
  letter-spacing: 0.06em;
  transition: color .18s, background .18s;
}

.rs-item.on {
  background: var(--card);
  color: var(--accent);
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(26, 30, 28, .05);
}

/* 选班级面板：学院 → 专业 → 班级，逐级点 */
.sheet.class-sheet {
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.cs-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0 18rpx;
}

.cs-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.cs-back {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--accent);
  padding: 12rpx 24rpx 12rpx 0;
}

.cs-close {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  color: var(--muted);
  padding: 12rpx 0 12rpx 24rpx;
}

.cs-scroll {
  flex: 1;
  height: 0;
  min-height: 320rpx;
}

.cs-line {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 6rpx 0 4rpx;
  border-bottom: 1rpx solid #F2EFE6;
}

.cs-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
}

.cs-n {
  flex: none;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.cs-arrow {
  flex: none;
  margin-left: 10rpx;
  display: flex;
  align-items: center;
  color: #C8CDC6;
}

.cs-empty {
  padding: 70rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}

/* 老师课表点开只读：两行键值 */
.kv {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 2rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.kv .k {
  flex: none;
  width: 96rpx;
  color: var(--muted);
}

.kv .v {
  flex: 1;
  color: var(--ink);
}

/* 找老师：搜索框压在列表上，命中数一行小字 */
.tq-wrap {
  padding: 0 4rpx 10rpx;
}

.tq-input {
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: #F6F4EE;
  font-size: 24rpx;
  color: var(--ink);
}

.tq-ph {
  color: #AEB3AC;
}

.tq-count {
  padding: 0 6rpx 12rpx;
  font-size: 18rpx;
  color: var(--muted);
  letter-spacing: 0.02em;
}

/* 例外：本周停课原位灰色占位 */
.block.ex-cancel {
  background-color: #F1EFE9;
  border: 2rpx dashed #D7D3C8;
  padding: 14rpx 8rpx 10rpx;
}

.block.ex-cancel .b-name {
  color: var(--muted);
  font-weight: 500;
}

/* 例外角标：调课「调」、临时加课「补」 */
.b-tag {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  min-width: 26rpx;
  height: 26rpx;
  line-height: 26rpx;
  text-align: center;
  padding: 0 6rpx;
  border-radius: 13rpx;
  background: rgba(255, 255, 255, 0.28);
  color: #fff;
  font-size: 15rpx;
  font-weight: 600;
}


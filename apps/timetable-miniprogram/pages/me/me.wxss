.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 0;
}

/* ===== 品牌概览头 ===== */
.hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: var(--brand-soft);
}

.hero-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--brand);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  flex: none;
}

.av-line {
  width: 36rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #FFFFFF;
}

.av-line.l2 {
  width: 26rpx;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0.02em;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 0.04em;
}

/* ===== 数据概览 ===== */
.stat-card {
  display: flex;
  margin-top: 20rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(26, 30, 28, 0.04);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.1;
}

.stat-label {
  font-size: 22rpx;
  color: var(--muted);
}

.stat-note {
  padding: 12rpx 12rpx 0;
  font-size: 22rpx;
  color: var(--muted);
}

/* ===== 通用卡片 ===== */
.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 4rpx 28rpx 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(26, 30, 28, 0.04);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 28rpx;
  color: var(--ink);
}

.row-value {
  font-size: 28rpx;
  color: var(--muted);
}

.row-title {
  padding: 22rpx 0 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.row-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  flex: 1;
}

.row-slot {
  font-size: 22rpx;
  color: var(--muted);
}

.restore {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background: var(--brand-soft);
  font-size: 24rpx;
  color: var(--brand);
}

/* ===== 功能入口列表 ===== */
.link {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 96rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.link:last-child {
  border-bottom: none;
}

.link-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex: none;
}

.link-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.link-label {
  font-size: 28rpx;
  color: var(--ink);
}

.link-sub {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}

.link-arrow {
  flex: none;
  display: flex;
  align-items: center;
  color: var(--muted);
  padding-left: 8rpx;
}

/* 导入：向下箭头 + 底线 */
.imp-arrow {
  width: 0;
  height: 0;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-top: 10rpx solid var(--brand);
  margin-bottom: 5rpx;
}

.imp-base {
  position: absolute;
  bottom: 16rpx;
  width: 22rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--brand);
}

/* 作业：勾选块 + 两条横线 */
.hw-box {
  position: absolute;
  left: 15rpx;
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid var(--brand);
  border-radius: 3rpx;
}

.hw-line {
  position: absolute;
  right: 15rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--brand);
}

.hw-line.hl1 {
  top: 19rpx;
  width: 20rpx;
}

.hw-line.hl2 {
  bottom: 19rpx;
  width: 14rpx;
}

/* 成绩：三根柱条，底对齐 */
.ic-grade {
  align-items: flex-end;
  padding-bottom: 15rpx;
}

.gr-bar {
  width: 7rpx;
  margin: 0 1.5rpx;
  border-radius: 2rpx;
  background: var(--brand);
}

.gr-bar.g1 {
  height: 16rpx;
}

.gr-bar.g2 {
  height: 26rpx;
}

.gr-bar.g3 {
  height: 12rpx;
}

/* ===== 关于与置底操作 ===== */
.para {
  padding: 14rpx 0;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.7;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 28rpx;
}

.reset-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid #F7D4D6;
  font-size: 26rpx;
  color: #E5484D;
}

.note {
  margin-top: 20rpx;
  margin-bottom: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}
